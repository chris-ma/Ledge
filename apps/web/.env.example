# Populated automatically once Neon is connected via the Vercel project's
# Storage tab (Project -> Storage -> Connect -> Neon). Pull with:
#   vercel env pull .env
DATABASE_URL=

# Set manually as a Vercel project env var (any random string). Vercel Cron
# sends this as `Authorization: Bearer $CRON_SECRET` automatically; the
# /api/cron/refresh handler rejects any request without a matching bearer.
CRON_SECRET=
